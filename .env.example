# Optional: Override Firebase config via environment variables for Netlify deployment.
# When omitted in AI Studio, src/firebase/config.ts falls back to firebase-applet-config.json.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Server-side Gemini API key (never prefix with VITE_).
GEMINI_API_KEY=""
